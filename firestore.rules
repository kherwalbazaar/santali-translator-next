rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read access to all users
    match /{document=**} {
      allow read: if true;
    }

    // Allow write access to authenticated users only
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Dictionary words - read for all, write for admin only
    match /words/{wordId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Favorites - user can only access their own
    match /favorites/{favId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Search history - user can only access their own
    match /searchHistory/{historyId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
